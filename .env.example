# --- Πλατφόρμα προορισμού (μόνο joomla υποστηρίζεται προς το παρόν) ---
WEBSITE_PLATFORM=joomla

# --- Email (IMAP) - κοινός λογαριασμός sch.gr αφιερωμένος στις αναρτήσεις ---
WEBSITE_POST_EMAIL_IMAP_SERVER=imap.sch.gr
WEBSITE_POST_EMAIL_IMAP_PORT=993
WEBSITE_POST_EMAIL_SENDER_ADDRESS=anakoinoseis@sch.gr
WEBSITE_POST_EMAIL_USERNAME=anakoinoseis@sch.gr
WEBSITE_POST_EMAIL_PASSWORD=

# --- Joomla site ---
WEBSITE_URL=https://dipe.zak.sch.gr
WEBSITE_POST_HTTPS_PORT=443
WEBSITE_POST_API_TOKEN=
WEBSITE_POST_CATEGORY_ID=

# Adapters όπως εμφανίζονται στο Content -> Media του Joomla (Settings -> Adapters)
WEBSITE_POST_MEDIA_ADAPTER_IMAGES=local-images
WEBSITE_POST_MEDIA_ADAPTER_DOCS=local-documents
WEBSITE_POST_MEDIA_SUBPATH=mail-posts

# --- Έλεγχος πρόσβασης ---
# Comma-separated λίστα emails που επιτρέπεται να ποστάρουν
WEBSITE_POST_WHITELIST_EMAIL_ADDRESSES=director@example.gr

# --- Defaults δημοσίευσης ---
WEBSITE_POST_DEFAULT_STATUS=DRAFT
WEBSITE_POST_DEFAULT_FEATURED=NO

# --- Εικόνες ---
WEBSITE_POST_IMAGE_MAX_WIDTH=1600
WEBSITE_POST_IMAGE_JPEG_QUALITY=75

# --- Logging ---
WEBSITE_POST_LOG_FILE_PATH=logs/post_log.csv

# --- Δοκιμαστική λειτουργία: YES = δεν δημιουργούνται πραγματικά άρθρα ---
WEBSITE_POST_DRY_RUN=NO
